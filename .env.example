# Backend (optional - these already default sensibly, only set if you need to override)
# Where the SQLite database file is written.
SCRAPEGUARD_DATA_DIR=backend/data

# Frontend (frontend/.env.local) - only needed if the backend isn't on localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Bright Data CLI auth is NOT an env var - run `npx -p @brightdata/cli bdata login`
# once and it stores a token in ~/.config/brightdata-cli/. Not required to run the
# demo: scripts/seed_demo.sh replays pre-captured real Bright Data output instead
# of calling the CLI live.
